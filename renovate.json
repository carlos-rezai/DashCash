{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":disableDependencyDashboard"
  ],
  "semanticCommits": "disabled",
  "minimumReleaseAge": "14 days",
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "rollback",
        "bump",
        "replacement"
      ],
      "groupName": "npm packages",
      "commitMessage": "chore: [supply-chain] update npm dependencies",
      "prTitle": "chore: [supply-chain] update npm dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "commitMessage": "chore: [supply-chain] update github actions",
      "prTitle": "chore: [supply-chain] update github actions"
    },
    {
      "matchManagers": ["nvm", "npm"],
      "matchDepNames": ["node"],
      "enabled": true,
      "groupName": "node",
      "commitMessage": "chore: [supply-chain] update node",
      "prTitle": "chore: [supply-chain] update node"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "commitMessage": "chore: [supply-chain] refresh the lockfile",
    "prTitle": "chore: [supply-chain] refresh the lockfile"
  },
  "vulnerabilityAlerts": {
    "commitMessage": "chore: [supply-chain] fix vulnerable dependencies",
    "prTitle": "chore: [supply-chain] fix vulnerable dependencies",
    "commitMessageSuffix": ""
  }
}
